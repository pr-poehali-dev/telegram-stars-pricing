{
  "tests": [
    {
      "name": "Test payment creation with valid amount",
      "method": "POST",
      "body": {
        "amount": 100,
        "description": "Test payment",
        "customerName": "Иван Иванов",
        "customerEmail": "test@example.com"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "paymentUrl": "string",
        "regPayNum": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Test payment creation without amount",
      "method": "POST",
      "body": {
        "description": "Test payment"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "Amount is required"
      },
      "bodyMatcher": "partial"
    }
  ]
}
