{
  "tests": [
    {
      "name": "Create payment with valid data",
      "method": "POST",
      "body": {
        "amount": 5000,
        "user_name": "Тестовый клиент",
        "user_email": "test@example.com",
        "user_phone": "+79001234567",
        "cart_items": [
          {
            "id": "1",
            "name": "Дизайн",
            "price": 5000,
            "quantity": 1
          }
        ],
        "order_comment": "Тестовый заказ"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "order_number": "string",
        "payment_url": "string",
        "amount": 5000
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject invalid amount",
      "method": "POST",
      "body": {
        "amount": 0,
        "user_name": "Клиент"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}
